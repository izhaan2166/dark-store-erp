{
  "name": "dark-store-erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @dse/db build && pnpm -r typecheck",
    "test": "pnpm --filter @dse/db build && pnpm -r test",
    "db:generate": "pnpm --filter @dse/db generate",
    "db:migrate": "pnpm --filter @dse/db build && pnpm --filter @dse/db migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  }
}
